{
  "framework": "chakra",
  "libraries": [
    {
      "name": "theme",
      "path": "libs/theme",
      "storyTitlePrefix": "Theme"
    },
    {
      "name": "ui",
      "path": "libs/ui",
      "storyTitlePrefix": "Ui"
    }
  ],
  "storyFilePattern": "**/*.stories.{ts,tsx}",
  "componentPatterns": [
    "**/src/**/*.tsx",
    "**/lib/**/*.tsx",
    "!**/*.stories.tsx",
    "!**/*.test.tsx",
    "!**/*.spec.tsx"
  ],
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.storybook/**"
  ],
  "storybookVersion": 10
}
